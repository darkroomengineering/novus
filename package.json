{
  "name": "novus",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "sanity:typegen": "bun sanity:extract && bun sanity:generate",
    "sanity:extract": "bun --bun sanity schema extract --path ./lib/types/sanity/schema.json",
    "sanity:generate": "bun --bun sanity typegen generate --config-path ./lib/types/sanity/gen-config.json"
  },
  "dependencies": {
    "@react-router/node": "^7.8.2",
    "@react-router/serve": "^7.8.2",
    "@sanity/client": "^7.11.1",
    "@sanity/preview-url-secret": "^2.1.15",
    "@sanity/react-loader": "^1.11.19",
    "@sanity/vision": "^4.8.0",
    "@sanity/visual-editing": "^3.0.5",
    "groq": "^4.8.0",
    "isbot": "^5.1.30",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2",
    "sanity": "^4.8.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@react-router/dev": "^7.8.2",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^20.19.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "ultracite": "5.3.2",
    "vite": "^7.1.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
