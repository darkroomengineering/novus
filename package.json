{
  "name": "novus",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "sanity:typegen": "bun sanity:extract && bun sanity:generate",
    "sanity:extract": "bun --bun sanity schema extract --path ./sanity/types/schema.json",
    "sanity:generate": "bun --bun sanity typegen generate --config-path ./sanity/types/gen-config.json"
  },
  "dependencies": {
    "@react-router/node": "^7.7.1",
    "@react-router/serve": "^7.7.1",
    "@sanity/client": "^7.8.2",
    "@sanity/preview-url-secret": "^2.1.14",
    "@sanity/react-loader": "^1.11.18",
    "@sanity/vision": "^4.4.1",
    "@sanity/visual-editing": "^3.0.3",
    "animejs": "^4.1.3",
    "groq": "^4.4.1",
    "isbot": "^5.1.27",
    "motion": "^12.23.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.1",
    "sanity": "^4.4.1",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.7.1",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild"
  ]
}